---
import Rich from './Rich.astro';
import { profile } from '../content/profile';
import { hasResume } from '../lib/site-data';
import { splitWords } from '../lib/split';

interface Props {
  vars: { total: string; since: string };
}
const { vars } = Astro.props;
const words = splitWords(profile.statement);
const resume = hasResume();
---
<section class="hero" aria-label="Introduction">
  <h1 class="statement">{words.map((w, i) => <><span class="w" style={`--d:${350 + i * 55}ms`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}</h1>
  <p class="lede"><Rich text={profile.lede} vars={vars} /></p>
  <div class="actions">
    {profile.availability && <span class="avail"><i aria-hidden="true"></i>{profile.availability}</span>}
    {resume && <a class="btn solid" href={profile.resume} download>Resume ↓</a>}
    <a class="btn" href="#contact">Email</a>
    <a class="btn" href={`https://github.com/${profile.github}`}>GitHub ↗</a>
  </div>
  <p class="strip"><span class="lbl">Contributing to</span>{profile.contributingTo.map((n, i) => <span style={`--i:${i + 1}`}>{n}</span>)}</p>
</section>

<style is:global>
  .hero { padding: 56px 0 8px; }
  .statement { max-width: 470px; margin: 0 0 18px; font-size: 27px; font-weight: 500; line-height: 1.22; letter-spacing: -.025em; text-wrap: balance; }
  .statement .w { display: inline-block; opacity: 0; filter: blur(7px); transform: translateY(7px); animation: hero-w .75s var(--ease-out) var(--d) forwards; }
  @keyframes hero-w { to { opacity: 1; filter: none; transform: none; } }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .lede { margin: 0 0 22px; font-size: 16px; color: var(--fg2); opacity: 0; animation: hero-rise .9s .95s var(--ease-out) forwards; }
  .lede strong { color: var(--fg); font-weight: 500; }
  .lede a { background: linear-gradient(var(--line), var(--line)) 0 100% / 100% 1px no-repeat; }
  .lede a:hover { background-image: linear-gradient(currentColor, currentColor); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; opacity: 0; animation: hero-rise .9s 1.1s var(--ease-out) forwards; }
  .btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border: 1px solid var(--line); border-radius: 9px; font-size: 13px; font-weight: 500; transition: border-color .2s, transform .15s, opacity .2s; }
  .btn:hover { border-color: var(--mut); }
  .btn:active { transform: scale(.97); }
  .btn.solid { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .btn.solid:hover { opacity: .88; }
  .avail { display: inline-flex; align-items: center; gap: 7px; margin-right: 6px; font-size: 13px; color: var(--fg2); }
  .avail i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 20%, transparent); }
  .strip { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 30px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--mut); font: 400 11px var(--font-mono), ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .strip span { opacity: 0; animation: hero-rise .7s var(--ease-out) forwards; animation-delay: calc(1.25s + var(--i, 0) * 80ms); transition: color .2s; }
  .strip span:hover { color: var(--fg); }
  .strip .lbl { font: 400 12px var(--font-sans), system-ui, sans-serif; letter-spacing: 0; text-transform: none; }
  @media (max-width: 480px) { .statement { font-size: 23px; } }
</style>
