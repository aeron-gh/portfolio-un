---
import { profile } from '../content/profile';
import { splitLetters } from '../lib/split';

const letters = splitLetters(profile.name);
---
<header class="hd" data-header>
  <div class="col hd-in">
    <a class="who" href="/" aria-label={profile.name}>
      <span class="name" aria-hidden="true">{letters.map((c, i) => <span class="ch"><span style={`--d:${i * 26 + 60}ms`}>{c === ' ' ? ' ' : c}</span></span>)}</span>
      <span class="sub" aria-hidden="true">{profile.tagline}</span>
    </a>
    <div class="hd-r">
      <button class="boot-pill" type="button" data-boot><span class="led" aria-hidden="true"></span>Boot Ubuntu <kbd>U</kbd></button>
      <button class="cmdk" type="button" data-cmdk aria-label="Open command menu"><kbd class="k-keys">Ctrl K</kbd><span class="k-touch">Menu</span></button>
    </div>
  </div>
  <div class="prog" data-progress aria-hidden="true"></div>
</header>

<script>
  import '../scripts/header';
</script>

<style is:global>
  .hd { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .hd.scrolled { border-bottom-color: var(--line); }
  .hd-in { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .who { display: block; line-height: 1.3; }
  .name { display: block; font-size: 15px; font-weight: 500; }
  .name .ch { display: inline-block; overflow: hidden; vertical-align: top; }
  .name .ch > span { display: inline-block; transform: translateY(105%); animation: hd-up .75s var(--ease-out) var(--d) forwards; }
  .sub { display: block; font-size: 13px; color: var(--mut); opacity: 0; animation: hd-fade .8s .5s forwards; }
  .hd-r { display: flex; gap: 8px; align-items: center; opacity: 0; animation: hd-fade .8s .65s forwards; }
  @keyframes hd-up { to { transform: none; } }
  @keyframes hd-fade { to { opacity: 1; } }
  .boot-pill { display: inline-flex; align-items: center; gap: 8px; padding: 4px 5px 4px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--chip); font-size: 12px; font-weight: 500; transition: border-color .2s, transform .15s; }
  .boot-pill:hover { border-color: var(--mut); }
  .boot-pill:active { transform: scale(.96); }
  .led { width: 6px; height: 6px; border-radius: 50%; background: var(--acc); animation: ring 2.2s infinite; }
  .cmdk { display: inline-flex; }
  .k-touch { display: none; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 12px; font-weight: 500; }
  .prog { position: absolute; left: 0; bottom: -1px; width: 100%; height: 1px; background: var(--fg); opacity: .5; transform-origin: left; transform: scaleX(0); }
  @media (hover: none), (max-width: 719px) { .boot-pill { display: none; } }
  @media (hover: none) { .k-keys { display: none; } .k-touch { display: inline-block; } }
  @media (max-width: 420px) { .sub { display: none; } }
</style>
