  .desk-boot { position: absolute; inset: 0; display: grid; place-items: center; background: #000; transition: opacity .35s; }
  .desk.ready .desk-boot { opacity: 0; pointer-events: none; }
  .desk-boot > div { opacity: 0; animation: desk-in .3s .65s forwards; }
  @keyframes desk-in { to { opacity: 1; } }
  .desk-logo { position: relative; width: 54px; height: 54px; margin: 0 auto 22px; border: 5px solid #fff; border-radius: 50%; }
  .desk-logo::after { content: ''; position: absolute; inset: 9px; border-radius: 50%; background: #e95420; }
  .desk-dots { display: flex; gap: 8px; justify-content: center; }
  .desk-dots i { width: 7px; height: 7px; border-radius: 50%; background: #555; animation: desk-dot 1.2s infinite; }
  .desk-dots i:nth-child(2) { animation-delay: .15s; }
  .desk-dots i:nth-child(3) { animation-delay: .3s; }
  .desk-dots i:nth-child(4) { animation-delay: .45s; }
  .desk-dots i:nth-child(5) { animation-delay: .6s; }
  @keyframes desk-dot { 0%, 100% { background: #555; } 40% { background: #e95420; } }
