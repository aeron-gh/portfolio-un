  .desk-error-actions { display: flex; gap: 10px; justify-content: center; }
  .desk-error button { padding: 6px 14px; border: 1px solid #444; border-radius: 8px; color: #eee; }
  .desk-error button:hover { border-color: #888; }
  html.desk-open { overflow: hidden; }
  html.desk-open .mini { visibility: hidden; }
</style>
