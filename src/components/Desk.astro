<div class="desk" data-desk role="dialog" aria-modal="true" aria-label="Ubuntu desktop" tabindex="-1" hidden>
  <div class="desk-boot" data-desk-boot aria-hidden="true">
    <div><div class="desk-logo"></div><div class="desk-dots"><i></i><i></i><i></i><i></i><i></i></div></div>
  </div>
  <p class="desk-hint" aria-live="polite">Press Esc to come back to the page</p>
  <div class="desk-error" data-desk-error role="alert" hidden>
    <p>Couldn't start the machine.</p>
    <p class="desk-error-actions"><button type="button" data-desk-retry>Retry</button><button type="button" data-desk-close>Close</button></p>
  </div>
</div>

<script>
  import '../scripts/machine';
</script>

<style is:global>
  .desk { position: fixed; inset: 0; z-index: 90; overflow: hidden; background: #000; transform-origin: 0 0; outline: none; }
  .desk[hidden] { display: none; }
